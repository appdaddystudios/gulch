{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "types": ["vitest"]
  },
  "include": [
    "app/**/*.tsx",
    "app/**/*.ts",
    "components/**/*.tsx",
    "components/**/*.ts",
    "hooks/**/*.ts",
    "theme/**/*.ts",
    "lib/**/*.ts",
    "*.ts",
    "*.js",
    "*.d.ts"
  ]
}

{
  "expo": {
    "name": "Gulch",
    "slug": "gulch",
    "scheme": "gulch",
    "version": "1.0.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@rnmapbox/maps",
      [
        "expo-calendar",
        {
          "calendarPermission": "Gulch adds events you choose to your calendar."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#B87832",
          "enableFullScreenImage_legacy": true,
          "android": {
            "image": "./assets/icon.png",
            "imageWidth": 200
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gulch.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gulch.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#3F220F"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "extra": {
      "supabaseUrl": "$EXPO_PUBLIC_SUPABASE_URL",
      "posthogHost": "$EXPO_PUBLIC_POSTHOG_HOST",
      "router": {},
      "eas": {
        "projectId": "df8b221c-aaee-49c8-994c-f4f85432f281"
      }
    },
    "owner": "carlhiggins"
  }
}

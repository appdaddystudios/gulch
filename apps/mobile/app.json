{
  "expo": {
    "name": "Gulch",
    "slug": "gulch",
    "scheme": "gulch",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-font",
      "@sentry/react-native",
      "expo-web-browser"
    ],
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gulch.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gulch.mobile"
    },
    "extra": {
      "supabaseUrl": "$EXPO_PUBLIC_SUPABASE_URL",
      "sentryDsn": "$EXPO_PUBLIC_SENTRY_DSN",
      "posthogHost": "$EXPO_PUBLIC_POSTHOG_HOST",
      "router": {},
      "eas": {
        "projectId": "df8b221c-aaee-49c8-994c-f4f85432f281"
      }
    },
    "owner": "carlhiggins"
  }
}

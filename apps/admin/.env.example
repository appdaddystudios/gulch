EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
# Service-role key for admin writes (server actions only — never exposed to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (https://dashboard.clerk.com → API keys). Publishable key is public; secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where Clerk sends signed-out visitors — must match app/sign-in/[[...sign-in]]
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Comma-separated emails allowed into the dashboard (case-insensitive). Empty = app refuses to serve.
ADMIN_ALLOWED_EMAILS=owner@example.com,editor@example.com
